  <diagram name="Runner engine" id="vcc-runner">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="860" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="VCC-Workflow &#8212; Runner engine" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#232F3E;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="720" height="26" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="How one run executes. Four stages repeat until the work passes or a guardrail stops it. Every step streams progress to the UI." style="text;html=1;fontSize=12;fontColor=#6B7280;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="46" width="960" height="18" as="geometry" />
        </mxCell>
        <mxCell id="gr" value="Guardrails, enforced" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCFCFD;strokeColor=#DD344C;dashed=1;verticalAlign=top;align=left;fontColor=#DD344C;fontStyle=1;spacingLeft=10;spacingTop=6;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="210" height="248" as="geometry" />
        </mxCell>
        <mxCell id="gr1" value="maxRetries" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE7EA;strokeColor=#DD344C;fontColor=#232F3E;fontSize=11;" vertex="1" parent="gr">
          <mxGeometry x="20" y="36" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="gr2" value="maxLoopDepth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE7EA;strokeColor=#DD344C;fontColor=#232F3E;fontSize=11;" vertex="1" parent="gr">
          <mxGeometry x="20" y="86" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="gr3" value="budget (tokens)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE7EA;strokeColor=#DD344C;fontColor=#232F3E;fontSize=11;" vertex="1" parent="gr">
          <mxGeometry x="20" y="136" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="gr4" value="stageTimeoutMs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE7EA;strokeColor=#DD344C;fontColor=#232F3E;fontSize=11;" vertex="1" parent="gr">
          <mxGeometry x="20" y="186" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="start" value="Board card&#10;a requirement" style="rounded=1;arcSize=45;whiteSpace=wrap;html=1;fillColor=#EDEFF3;strokeColor=#6B7280;fontColor=#232F3E;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="470" y="80" width="150" height="52" as="geometry" />
        </mxCell>
        <mxCell id="plan" value="1. Plan&#10;build the plan and sub-tasks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F6EF;strokeColor=#1a9c68;fontColor=#232F3E;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="170" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="act" value="2. Act&#10;apply changes via the adapter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F6EF;strokeColor=#1a9c68;fontColor=#232F3E;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="275" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="verify" value="3. Verify&#10;run tests and checks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F6EF;strokeColor=#1a9c68;fontColor=#232F3E;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="380" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="decide" value="4. Decide&#10;passed, or breached?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FDF2E3;strokeColor=#C9761B;fontColor=#232F3E;fontSize=12;fontStyle=1;" vertex="1" parent="1">
