{
  "name": "vcc-workflow",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "start:standalone": "pnpm --filter @vcc-workflow/schema build && pnpm --filter @vcc-workflow/api prisma:migrate && pnpm dev",
    "server": "docker compose -f docker-compose.hosted.yml up --build",
    "server:dev": "node scripts/server-dev.mjs"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}
