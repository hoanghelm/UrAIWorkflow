# Dependencies
node_modules/
.pnpm-store/

# Playwright browser packs — vendored out-of-band, too large for git
vendor/
pw-browser-pack-*.tar.gz
apps/server/scripts/browsers-*/

# Desktop installer staging output (produced by bundle.ps1)
apps/desktop/build/stage/

# Build output
dist/
build/
# keep the desktop installer build SOURCE (bundle.ps1); only its stage/ output is ignored
!apps/desktop/build/
apps/desktop/build/stage/
.turbo/
coverage/
*.tsbuildinfo

# .NET build output
[Bb]in/
[Oo]bj/
*.user
*.suo
.vs/
TestResults/
*.nupkg

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Environment / secrets — never commit these
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.keystore
id_rsa
id_ed25519
*.crt
secrets.json
.secrets
*credentials*
*secret*.json

# Local databases (may hold connector API keys)
*.db
*.db-journal
*.db-wal
*.db-shm
*.db.bak-*
*.sqlite
*.sqlite3

# Runtime state (worktrees, previews, artifact bundles, harness)
.harness/
worktrees/
.worktrees/

# Generated example apps produced by runs
examples/

# Claude harness — kept locally on disk, not published to GitHub
.claude/
**/settings.local.json

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.local
