# Install fresh inside the image (gets Linux-native binaries)
**/node_modules

# Build output / caches
**/dist
**/build
.turbo
*.tsbuildinfo

# VCS + logs
.git
.gitignore
*.log

# Secrets / local env (image creates .env from .env.example)
**/.env
**/.env.*
!**/.env.example

# Local databases and runtime state
**/*.db
**/*.db-journal
**/*.db-wal
**/*.db-shm
**/*.sqlite
apps/api/prisma/data
apps/api/data
.harness
worktrees
.worktrees

# Editor / OS
.vscode
.idea
.DS_Store
