{
  "name": "@vcc-workflow/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.spec.ts",
    "test:e2e": "tsx --test test/**/*.e2e-spec.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "gen:pg-schema": "node prisma/gen-postgres-schema.mjs",
    "prisma:pg:generate": "prisma generate --schema=prisma/postgres/schema.prisma",
    "prisma:pg:deploy": "prisma migrate deploy --schema=prisma/postgres/schema.prisma"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.222",
    "@anthropic-ai/sdk": "^0.32.1",
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/platform-socket.io": "^10.4.4",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/websockets": "^10.4.4",
    "@prisma/client": "^5.20.0",
    "@vcc-workflow/schema": "workspace:*",
    "adm-zip": "^0.6.0",
    "chokidar": "^3.6.0",
    "dependency-cruiser": "^18.1.1",
    "nanoid": "^3.3.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.0",
    "tar": "^7.5.22",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@types/adm-zip": "^0.5.8",
    "@types/express": "^5.0.0",
    "@types/node": "^20.16.11",
    "@types/tar": "^7.0.87",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
