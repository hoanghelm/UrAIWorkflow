DATABASE_URL="file:./data/vcc-workflow.db"
PORT=3001
WEB_ORIGIN=http://localhost:5173
WORKSPACE_ROOT=

# Deployment: "local" (default, SQLite, no auth) or "hosted" (Postgres, token-gated).
DEPLOYMENT_MODE=local
# Required in hosted mode: callers must send Authorization: Bearer <this>.
HOSTED_ACCESS_TOKEN=
# Optional: master key for encrypting connector secrets at rest. If unset, a
# local key file is generated at data/encryption.key.
VCC_ENCRYPTION_KEY=
