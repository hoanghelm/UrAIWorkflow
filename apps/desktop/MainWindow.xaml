<Window x:Class="Vcc.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="VCC-Workflow" Height="900" Width="1440" WindowStartupLocation="CenterScreen"
        Background="#0B0D12">
    <Grid>
        <wv2:WebView2 x:Name="Web" Visibility="Collapsed" />
        <StackPanel x:Name="Splash" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid Width="60" Height="60" HorizontalAlignment="Center" Margin="0,0,0,26">
                <Ellipse Width="60" Height="60" Stroke="#1B2030" StrokeThickness="5" />
                <Path Width="60" Height="60" Stroke="#E8734A" StrokeThickness="5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M 30,4 A 26,26 0 1 1 4,30"
                      RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <RotateTransform x:Name="Spin" />
                    </Path.RenderTransform>
                    <Path.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Spin" Storyboard.TargetProperty="Angle"
                                                     From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Path.Triggers>
                </Path>
            </Grid>
            <TextBlock Text="VCC-Workflow" FontFamily="Segoe UI" FontSize="26" FontWeight="SemiBold"
                       Foreground="#E6E8EC" HorizontalAlignment="Center" />
            <TextBlock x:Name="Status" Text="Loading resources…" FontFamily="Segoe UI" FontSize="13"
                       Foreground="#8B92A0" Margin="0,12,0,0" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
